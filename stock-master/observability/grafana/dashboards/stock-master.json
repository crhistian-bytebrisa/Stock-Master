{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "preload": false,
  "panels": [
    {
      "type": "stat",
      "title": "Total de peticiones HTTP",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(http_server_requests_seconds_count)",
          "instant": true,
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "fixed", "fixedColor": "blue"}
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Peticiones por método HTTP",
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (method) (http_server_requests_seconds_count)",
          "instant": true,
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "lcd"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "fixed", "fixedColor": "blue"}
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Peticiones por código de estado (200, 201, 400, 500...)",
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (status) (http_server_requests_seconds_count)",
          "instant": true,
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "lcd"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "blue", "value": 300},
              {"color": "orange", "value": 400},
              {"color": "dark-red", "value": 500}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "piechart",
      "title": "Peticiones por servicio/endpoint",
      "gridPos": {"h": 10, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (uri) (http_server_requests_seconds_count)",
          "instant": true,
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "pieType": "pie", "legendDisplayMode": "table"}
    },
    {
      "type": "piechart",
      "title": "Peticiones de la API por método HTTP",
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum by (method) (count_over_time({app=\"stock-master\", logger=\"api.request\"} | json [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "GET"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "POST"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "PUT"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "DELETE"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": ""},
        "pieType": "pie",
        "displayLabels": ["name"],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "tooltip": {"mode": "single", "sort": "none"}
      }
    },
    {
      "type": "bargauge",
      "title": "Conteo de registros en la base de datos",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "stockmaster_registros",
          "instant": true,
          "legendFormat": "{{entidad}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "orientation": "horizontal", "displayMode": "lcd"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {"mode": "fixed", "fixedColor": "purple"}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Peticiones por método en el tiempo",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (method) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineInterpolation": "smooth"}}},
      "options": {"tooltip": {"mode": "multi"}}
    },
    {
      "type": "logs",
      "title": "Logs de las peticiones a la API (Loki)",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 27},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{app=\"stock-master\", logger=\"api.request\"} | json",
          "refId": "A",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "direction": "backward"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "durationMs"}, "properties": [{"id": "unit", "value": "ms"}]}
        ]
      }
    }
  ],
  "refresh": "10s",
